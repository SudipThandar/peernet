<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Required by WifiManager.createMulticastLock().acquire(). Without it the
         acquire throws SecurityException, Wi-Fi power save keeps dropping mDNS
         frames on the P2P group, and discovery "randomly" finds nothing. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Wi-Fi Direct / nearby discovery -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Foreground hosting -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WAKE_LOCK is deliberately NOT declared. PowerManager wake locks are ruled
         out by design: keeping the CPU or screen awake to hold a tunnel up is the
         wrong fix and a battery complaint waiting to happen. The tunnel is held by
         WifiManager.WifiLock (WIFI_MODE_FULL_HIGH_PERF), which needs no permission,
         plus a user-granted Doze exemption. PowerManager is referenced in
         DozeExemptionPolicy only to read isIgnoringBatteryOptimizations, which does
         not require WAKE_LOCK. -->

    <!-- Battery optimization opt-out (requested with explanation, never forced) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- VPN (VpnService) is declared via its own permission on the service in a later milestone. -->

    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:name=".PeerNetApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PeerNet">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PeerNet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Host foreground service (Section 10.4): keeps sharing alive while
             the app is backgrounded or cleared, Android 14+ specialUse declared. -->
        <service
            android:name=".service.HostForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the local Wi-Fi Direct sharing network alive so nearby paired devices can bridge to this phone's internet connection." />
        </service>

        <!-- Client VPN tunnel. The SERVICE_INTERFACE filter is mandatory: the
             platform binds the VPN through it, and without it Builder.establish()
             just returns null (consent is granted, then nothing works). It must
             therefore be exported; BIND_VPN_SERVICE keeps it system-only.
             Type is specialUse, not systemExempted: systemExempted additionally
             requires FOREGROUND_SERVICE_SYSTEM_EXEMPTED plus a platform
             exemption, and throws SecurityException on Android 14+ without it. -->
        <service
            android:name=".service.PeerNetVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Carries this phone's internet traffic through a paired host phone's local Wi-Fi Direct tunnel while the tunnel is active." />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Notification Stop action: manifest receiver so delivery never
             depends on process state or OEM service-intent quirks. -->
        <receiver
            android:name=".service.HostNotificationActionReceiver"
            android:exported="false" />

        <!-- Same, for the client's tunnel notification. Its notification is
             ongoing and cannot be swiped, so this is the only way to end the
             tunnel without opening the app. -->
        <receiver
            android:name=".service.VpnNotificationActionReceiver"
            android:exported="false" />

    </application>

</manifest>
